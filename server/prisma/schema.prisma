generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model users {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(255)
  password      String?   @db.VarChar(255)
  phone_number  String?   @unique @db.VarChar(20)
  email         String?   @unique @db.VarChar(255)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @updatedAt @db.Timestamp(6)
  last_login    DateTime? @db.Timestamp(6)
  status        Int       @default(1) @db.SmallInt
  session_token String?   @db.VarChar(64)
  permissions   String[]  @default([])

  characters    characters?
}

// 角色表（精简版，默认灵石 10000）
model characters {
  id               Int      @id @default(autoincrement())
  user_id          Int      @unique
  nickname         String   @unique @db.VarChar(50)
  gender           String   @db.VarChar(10)
  title            String?  @default("散修") @db.VarChar(50)
  spirit_stones    BigInt   @default(10000)
  silver           BigInt   @default(0)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  users                        users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stock_holdings               character_stock_holding[]
  stock_trade_records          stock_market_trade_record[]
  stock_pending_orders         stock_market_pending_order[]
  shop_details                 shop_detail[]
  spirit_stones_ledger         spirit_stones_ledger[]
  // 仅用于 Prisma relation 校验，代码中不使用
  scratch_tickets              scratch_ticket[] @ignore
  month_card_ownerships        month_card_ownership[]
  month_card_daily_claims      month_card_daily_claim[]
  farm_profile                 farm_profile?
  farm_cells                   farm_cell[]
  farm_seed_inventories        farm_seed_inventory[]
  farm_harvest_inventories     farm_harvest_inventory[]
  farm_decorations             farm_decoration[]
  farm_activity_logs           farm_activity_log[]
  farm_plant_templates         farm_plant_template[]
  puzzle_cards                 puzzle_card[] @ignore
}

// 股票报价表
model stock_market_quote {
  stock_id                     String   @id @db.VarChar(96)
  current_price_spirit_stones  BigInt
  last_change_bps              Int      @default(0)
  last_tick_id                 BigInt?
  updated_at                   DateTime @default(now()) @db.Timestamp(6)
}

// 股市Tick表
model stock_market_tick {
  id              BigInt   @id @default(autoincrement())
  tick_hour       DateTime @unique @db.Timestamp(6)
  status          String   @db.VarChar(20)
  headline        String?
  summary         String?
  model_name      String?  @db.VarChar(100)
  prompt_snapshot String?
  event_id        BigInt?
  error_message   String?
  finished_at     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  price_histories stock_market_price_history[]
}

// 股票价格历史表
model stock_market_price_history {
  id                       BigInt    @id @default(autoincrement())
  stock_id                 String    @db.VarChar(96)
  tick_id                  BigInt
  price_spirit_stones      BigInt
  change_bps               Int
  direction                String    @db.VarChar(10)
  reason                   String?
  created_at               DateTime  @default(now()) @db.Timestamp(6)

  tick                     stock_market_tick @relation(fields: [tick_id], references: [id])

  @@index([stock_id, tick_id])
}

// 股市新闻事件表
model stock_market_news_event {
  id                 BigInt    @id @default(autoincrement())
  status             String    @db.VarChar(20)
  theme              String?
  headline           String?
  summary            String?
  stage              String?   @db.VarChar(50)
  affected_stock_ids String[]
  started_tick_id    BigInt?
  last_tick_id       BigInt?
  continuation_count Int       @default(0)
  updated_at         DateTime  @default(now()) @db.Timestamp(6)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
}

// 角色股票持仓表
model character_stock_holding {
  character_id                Int
  stock_id                    String   @db.VarChar(96)
  quantity                    Int
  frozen_quantity             Int      @default(0)
  total_cost_spirit_stones    BigInt
  created_at                  DateTime @default(now()) @db.Timestamp(6)
  updated_at                  DateTime @updatedAt @db.Timestamp(6)

  character                   characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@id([character_id, stock_id])
}

// 股票交易记录表
model stock_market_trade_record {
  id                           BigInt    @id @default(autoincrement())
  character_id                 Int
  stock_id                     String    @db.VarChar(96)
  side                         String    @db.VarChar(8)
  quantity                     Int
  unit_price_spirit_stones     BigInt
  gross_amount_spirit_stones   BigInt
  fee_spirit_stones            BigInt
  net_amount_spirit_stones     BigInt
  realized_pnl_spirit_stones   BigInt?
  created_at                   DateTime  @default(now()) @db.Timestamp(6)

  character                    characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@index([character_id, created_at])
  @@index([stock_id, created_at])
}

// 店铺Tick表（收租系统独立tick）
model shop_tick {
  id              BigInt   @id @default(autoincrement())
  tick_hour       DateTime @unique @db.Timestamp(6)
  status          String   @db.VarChar(20)         // running/generated/failed
  error_message   String?
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  finished_at     DateTime? @db.Timestamp(6)
}

// 店铺详情表（收租系统）
model shop_detail {
  id                    Int      @id @default(autoincrement())
  character_id          Int
  shop_type             String   @db.VarChar(10)         // DAN/MIN/BOO/PLT/ART/FBD
  area                  Int                               // 当前面积（㎡）= 初始面积 + 扩展次数 × 10
  decoration_tier       String   @db.VarChar(20)         // YELLOW/MYSTIC/EARTH/HEAVEN
  upgrade_level         Int      @default(0)             // 升级等级
  space_expansion       Int      @default(0)             // 空间阵法扩展次数
  pending_rent          BigInt   @default(0)             // 待收租金（单位：分）
  total_rent_collected  BigInt   @default(0)             // 累计已收租金（统计用）
  rent_tick_count       BigInt   @default(0)             // 累计收租次数（升级判断）
  last_rent_tick_id     BigInt?                           // 上一次结算的 tick ID（关联 shop_tick）
  last_decorate_tick_id BigInt?                           // 最近一次装修的 tick ID（用于跳过该 tick 租金）
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @updatedAt @db.Timestamp(6)

  character             characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, shop_type])
  @@index([character_id])
}

// 股市挂单表
model stock_market_pending_order {
  id                Int       @id @default(autoincrement())
  character_id      Int
  stock_id          String    @db.VarChar(50)
  side              String    @db.VarChar(10)       // buy/sell
  status            String    @db.VarChar(20)       @default("active") // active/filled/cancelled/expired
  quantity          Int
  limit_price_units BigInt
  trigger_mode      String    @db.VarChar(10)       @default("normal") // normal/premium
  created_at        DateTime  @default(now())       @db.Timestamp(6)
  filled_at         DateTime? @db.Timestamp(6)
  cancelled_at      DateTime? @db.Timestamp(6)

  character         characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@index([stock_id, status], map: "idx_pending_orders_stock_status")
  @@index([character_id, status], map: "idx_pending_orders_character_status")
  @@index([character_id], map: "idx_pending_orders_character")
}

// 灵石流水账表（单式记账簿）
model spirit_stones_ledger {
  id            BigInt   @id @default(autoincrement())
  character_id  Int
  amount        BigInt
  balance_after BigInt
  biz_type      String   @db.VarChar(32)
  biz_id        String?  @db.VarChar(128)
  counterparty  Int?
  memo          String?  @db.VarChar(500)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  character     characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@index([character_id], map: "idx_ledger_character")
  @@index([biz_type, biz_id], map: "idx_ledger_biz")
  @@index([character_id, created_at], map: "idx_ledger_character_time")
}

// 刮刮乐彩票表（每天最多 3 张独立票，按顺序刮完一张再下一张）
model scratch_ticket {
  id                BigInt   @id @default(autoincrement())
  character_id      Int
  day               DateTime @db.Date          // 票归属日期（UTC 日期）
  ticket_number     Int      @db.SmallInt      // 当天第几张票：1/2/3
  config_key        String   @db.VarChar(64)   // 关联种子配置 "3x3"/"4x4"/"5x5"
  grid_size         Int      @db.SmallInt      // 格子总数（如 9=3x3, 25=5x5）
  grid_values       Json     @db.JsonB         // 格子数值数组 [0..gridSize-1]
  scratched_mask    Int      @default(0)       // 位标记，第 i 位为 1 表示第 i 格已刮
  scratch_count     Int      @default(0)       // 该票已刮格子数（0-gridSize）
  max_scratch_count Int      @default(0) @db.SmallInt  // 最大可刮数
  status            String   @default("active") @db.VarChar(20) // active/completed/settled
  settled           Boolean  @default(false)   // 是否已开奖
  reset_flag        Boolean  @default(false)   // 是否已被重置
  selected_line     String?  @db.VarChar(32)   // 选中的线（如 "row_0", "diag_1"）
  line_sum          Int?     // 选中线的和值
  prize_tier        String?  @db.VarChar(32)   // 中奖等级键
  prize_amount      BigInt?  // 奖金金额
  created_at        DateTime @default(now())    @db.Timestamp(6)
  updated_at        DateTime @updatedAt         @db.Timestamp(6)

  character         characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, day, ticket_number], map: "uq_scratch_character_day_ticket")
  @@index([character_id, day], map: "idx_scratch_character_day")
  @@index([character_id, status], map: "idx_scratch_character_status")
  @@index([day, status], map: "idx_scratch_day_status")
  @@index([character_id, day, settled], map: "idx_scratch_settled")
}

// ========== 刮刮乐种子配置 ==========

model scratch_ticket_config {
  id                BigInt   @id @default(autoincrement())
  config_key        String   @unique @db.VarChar(64)
  ticket_number     Int      @unique @db.SmallInt
  grid_size         Int      @db.SmallInt
  max_scratch_count Int      @db.SmallInt
  min_visible_count Int      @db.SmallInt
  description       String?  @db.VarChar(200)
  created_at        DateTime @default(now())    @db.Timestamp(6)
  updated_at        DateTime @updatedAt         @db.Timestamp(6)

  prize_tiers       scratch_prize_tier[]
}

model scratch_prize_tier {
  id           BigInt   @id @default(autoincrement())
  config_id    BigInt
  tier_key     String   @db.VarChar(32)
  tier_name    String   @db.VarChar(50)
  sum_min      Int
  sum_max      Int
  prize_type   String   @default("spirit_stones") @db.VarChar(20)
  prize_amount BigInt
  sort_order   Int      @default(0) @db.SmallInt
  created_at   DateTime @default(now())    @db.Timestamp(6)

  config       scratch_ticket_config @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([config_id, tier_key])
  @@index([config_id])
}

// ========== 月卡系统 ==========

// 月卡持有记录
model month_card_ownership {
  id                    BigInt   @id @default(autoincrement())
  character_id          Int
  activated_at          DateTime @default(now()) @db.Timestamp(6)
  expires_at            DateTime @db.Timestamp(6)
  status                String   @default("active") @db.VarChar(20)
  total_days_purchased  Int      @default(0)
  purchase_count        Int      @default(0)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @updatedAt @db.Timestamp(6)

  character             characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@index([character_id, status], map: "idx_month_card_character")
  @@index([expires_at], map: "idx_month_card_expires")
  @@index([character_id, status, expires_at], map: "idx_month_card_character_active")
}

// 月卡每日领取记录
model month_card_daily_claim {
  id                    BigInt   @id @default(autoincrement())
  character_id          Int
  claim_date            DateTime @db.Date
  reward_spirit_stones  BigInt
  created_at            DateTime @default(now()) @db.Timestamp(6)

  character             characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, claim_date], map: "uq_daily_claim_character_date")
  @@index([character_id, claim_date], map: "idx_daily_claim_character_date")
}

// ========== 灵田系统 V2 ==========

// 角色灵田信息表
model farm_profile {
  id                     Int       @id @default(autoincrement())
  character_id           Int       @unique
  farm_tier              Int       @default(1) @db.SmallInt  // 等阶（1-4，对应黄/玄/地/天）
  farm_level             Int       @default(0) @db.SmallInt  // 等级（0-100）
  farm_exp               BigInt    @default(0)               // 当前等级经验
  max_row                Int       @default(4) @db.SmallInt
  total_harvest_count    Int       @default(0)
  harvest_count_by_crop  Json      @default("{}")
  initial_seeds_claimed  Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @updatedAt @db.Timestamp(6)

  character              characters @relation(fields: [character_id], references: [id], onDelete: Cascade)
}

// 灵田格子表
model farm_cell {
  id                     Int        @id @default(autoincrement())
  character_id           Int
  row                    Int        @db.SmallInt
  col                    Int        @db.SmallInt
  unlocked               Boolean    @default(false)
  crop_id                String?    @db.VarChar(64)
  planted_at             DateTime?  @db.Timestamp(6)
  mutated                Boolean    @default(false)
  mutation_type          String?    @db.VarChar(32)
  /// 待发放的杂交种子 itemId（种植时判定成功，进入第二阶段且金光变后实际发放）
  pending_hybrid_seed    String?    @db.VarChar(64)
  /// 种植的种子代数（用于计算收获产出的种子代数：parent.generation + 1）
  planted_generation     Int        @default(0)
  created_at             DateTime   @default(now()) @db.Timestamp(6)
  updated_at             DateTime   @updatedAt @db.Timestamp(6)

  character              characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, row, col])
  @@index([character_id])
  @@index([character_id, crop_id], map: "idx_farm_cell_crop")
}

// 种子背包表
model farm_seed_inventory {
  id              Int       @id @default(autoincrement())
  character_id    Int
  item_id         String    @db.VarChar(64)
  quantity        Int       @default(0)
  mutation_type   String    @default("") @db.VarChar(32)
  /// 种子代数（0=商店/初始种子，1=杂交产出，2+=后代）
  generation      Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  character       characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, item_id, mutation_type, generation])
  @@index([character_id])
}

// 灵材仓库表（按品质分别计数）
model farm_harvest_inventory {
  id              Int       @id @default(autoincrement())
  character_id    Int
  crop_id         String    @db.VarChar(64)
  quantity        Int       @default(0)
  quality         String    @default("normal") @db.VarChar(10)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)

  character       characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, crop_id, quality])
  @@index([character_id])
}

// 灵田装饰表
model farm_decoration {
  id                Int       @id @default(autoincrement())
  character_id      Int
  row               Int       @db.SmallInt
  col               Int       @db.SmallInt
  decoration_type   String    @db.VarChar(20)
  placed_at         DateTime  @default(now()) @db.Timestamp(6)

  character         characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, row, col])
  @@index([character_id])
}

// 灵田活动日志表（播种/收获/铲除/枯萎/杂交/变异记录）
model farm_activity_log {
  id              BigInt   @id @default(autoincrement())
  character_id    Int
  /// 活动类型：plant/harvest/remove/wither/hybrid/mutation
  activity_type   String   @db.VarChar(20)
  row             Int      @db.SmallInt
  col             Int      @db.SmallInt
  /// 作物 ID（枯萎/铲除时记录被处理的作物）
  crop_id         String?  @db.VarChar(64)
  /// 活动详情（JSON 格式，如产量、品质、变异类型、杂交配方等）
  metadata        Json     @db.JsonB
  created_at      DateTime @default(now()) @db.Timestamp(6)

  character       characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@index([character_id])
  @@index([character_id, created_at])
}

// 灵田种植模板表
model farm_plant_template {
  id              Int      @id @default(autoincrement())
  character_id    Int
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)

  character       characters               @relation(fields: [character_id], references: [id], onDelete: Cascade)
  items           farm_plant_template_item[]

  @@index([character_id])
}

// 灵田种植模板项表
model farm_plant_template_item {
  id              Int      @id @default(autoincrement())
  template_id     Int
  row_offset      Int      @db.SmallInt
  col_offset      Int      @db.SmallInt
  seed_item_id    String   @db.VarChar(64)
  mutation_type   String?  @db.VarChar(32)
  generation      Int?

  template        farm_plant_template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
}

// ========== 常驻刮刮乐 ==========

// 常驻刮刮乐彩票表（配置数据由 TypeScript 内存常量承载，无独立配置表）
model puzzle_card {
  id              BigInt    @id @default(autoincrement())
  character_id    Int
  ticket_number   BigInt
  type_key        String    @db.VarChar(32)
  grid_rows       Int       @db.SmallInt
  grid_cols       Int       @db.SmallInt
  price_paid      BigInt
  ticket_data     Json      @db.JsonB
  matched_lines   Json      @default("[]") @db.JsonB
  prize_type      String    @default("spirit_stones") @db.VarChar(20)
  prize_amount    BigInt    @default(0)
  redeemed_at     DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)

  character       characters @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, ticket_number])
  @@index([character_id])
  @@index([type_key])
}

