# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/stock_sim
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_sim
DB_USER=user
DB_PASSWORD=password
DB_LOG=true
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis配置
REDIS_URL=redis://localhost:6379

# JWT配置
JWT_SECRET=stock-sim-jwt-secret-key
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=http://localhost:5173

# AI模型配置 - 股市专用
AI_STOCK_MARKET_MODEL_PROVIDER=openai
AI_STOCK_MARKET_MODEL_URL=https://api.openai.com/v1
AI_STOCK_MARKET_MODEL_KEY=your-openai-api-key
AI_STOCK_MARKET_MODEL_NAME=gpt-4o-mini

# 服务器配置
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# 股市行情 tick 间隔（分钟），生产环境默认 30，开发可改为 5 等更小值
# STOCK_MARKET_TICK_INTERVAL_MINUTES=30

# 股市随机噪音波动上下限（百分比），未设置时默认 0.1% ~ 0.5%
# STOCK_MARKET_NOISE_MIN_CHANGE_PERCENT=0.1
# STOCK_MARKET_NOISE_MAX_CHANGE_PERCENT=0.5

# 股市随机噪音抖动开关，默认启用。设为 false 可关闭无交易股票的随机涨跌。
STOCK_MARKET_NOISE_ENABLED=false

# AI 新闻驱动器版本：v1（事件池续写）| v3（场景轮换 + 反转 + 叙事轨迹）
# 切换方式：修改此值后重启服务即可，一键回切同理。
STOCK_MARKET_DRIVER=v3

# AI 新闻驱动涨跌上限（百分比），默认 10%。绝对值超过此值的涨跌会被拒绝。
STOCK_MARKET_MAX_ABS_CHANGE_PERCENT=9

# AI 新闻驱动涨跌下限（百分比），默认 1.5%。AI 返回绝对值小于此值的涨跌时，自动抬升到下限 + 原小数位。
STOCK_MARKET_AI_MIN_ABS_CHANGE_PERCENT=1.5

# 单只股票单角色持仓上限（股），默认 100000。买入时超出部分自动截断，已达上限时拒绝成交。
STOCK_MAX_HOLDING_QUANTITY=100000

# 收租系统 tick 间隔（分钟），生产环境默认 30，开发可改为 5 等更小值
SHOP_RENT_TICK_INTERVAL_MINUTES=15
SHOP_RENT_SCHEDULER_ENABLED=true
SHOP_FEATURE_ENABLED=true

# 店铺系统 — 最大升级等级（默认 50）
UPGRADE_MAX_LEVEL=50
# 店铺系统 — 空间阵法最大扩展次数（默认 20）
SPACE_EXPANSION_MAX_COUNT=20

# 灵田系统 — 全局加速倍率（默认 1.0）
# 开发环境可设置为 > 1 加快作物生长速度，便于测试。例如 10.0 表示 10 倍速。
# FARM_ACCELERATION_MULTIPLIER=1.0

# 灵田系统 — 最大行数（默认 4，读取 plots.json 中的 grid.maxRows）
# 修改此值后需要重启服务，并确保 farmLevels 中对应等级的 maxRow 不超过此值。
# FARM_MAX_ROWS=4

# 认证系统 — QPS 限流配置
# 注册：按 IP 限流，固定时间窗内最大请求次数（默认 6 次 / 10 分钟）
AUTH_REGISTER_QPS_LIMIT=6
AUTH_REGISTER_QPS_WINDOW_MS=600000
# 登录：固定时间窗内最大请求次数（默认 12 次 / 分钟）
AUTH_LOGIN_QPS_LIMIT=12
AUTH_LOGIN_QPS_WINDOW_MS=60000

# 注册赠送灵石数量（默认 10000）
DEFAULT_REGISTRATION_SPIRIT_STONES=10000

# 刮刮乐系统 — 开关
# 是否允许重置今日奖票（默认 false）。开启后，全部已开奖时前端显示「重置」按钮，点击可清空重刮。
SCRATCH_ALLOW_RESET_TICKET=false
# 开奖是否不发放奖金（默认 false）。开启后，开奖仅记录结算结果，不实际发放灵石和流水，用于测试奖级规则。
SCRATCH_SETTLE_WITHOUT_PRIZE=false

# 时区设置，默认为上海时间
TZ=Asia/Shanghai
