# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/stock_sim
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_sim
DB_USER=user
DB_PASSWORD=password
DB_LOG=true
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis配置
REDIS_URL=redis://localhost:6379

# JWT配置
JWT_SECRET=stock-sim-jwt-secret-key
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=http://localhost:5173

# AI模型配置 - 股市专用
AI_STOCK_MARKET_MODEL_PROVIDER=openai
AI_STOCK_MARKET_MODEL_URL=https://api.openai.com/v1
AI_STOCK_MARKET_MODEL_KEY=your-openai-api-key
AI_STOCK_MARKET_MODEL_NAME=gpt-4o-mini

# 服务器配置
PORT=3000
NODE_ENV=development
LOG_LEVEL=info